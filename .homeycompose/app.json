{
  "id": "com.basmilius.listri",
  "version": "1.3.4",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "brandColor": "#57534e",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Lists",
    "nl": "Lijsten"
  },
  "description": {
    "en": "Create and manage shopping lists, tasks, and notes—right from your dashboard.",
    "nl": "Maak en beheer boodschappenlijstjes, taken en notities—rechtstreeks vanuit je dashboard."
  },
  "category": [
    "tools"
  ],
  "tags": {
    "en": [
      "list",
      "notes",
      "grocery list",
      "tasks"
    ],
    "nl": [
      "lijst",
      "notities",
      "boodschappen",
      "boodschappenlijst",
      "taken"
    ]
  },
  "permissions": [
    "homey:manager:api"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Bas Milius",
    "email": "bas@mili.us"
  },
  "bugs": {
    "url": "https://github.com/basmilius/homey-listri/issues"
  },
  "homepage": "https://bas.dev",
  "source": "https://github.com/basmilius/homey-listri",
  "support": "https://github.com/basmilius/homey-listri/issues",
  "homeyCommunityTopicId": 147274,
  "contributing": {
    "donate": {
      "paypal": {
        "username": "basmilius"
      },
      "githubSponsors": {
        "username": "basmilius"
      }
    }
  },
  "api": {
    "getLists": {
      "method": "GET",
      "path": "/lists"
    },
    "getList": {
      "method": "GET",
      "path": "/lists/:deviceId"
    },
    "getItems": {
      "method": "GET",
      "path": "/lists/:deviceId/items"
    },
    "getItem": {
      "method": "GET",
      "path": "/lists/:deviceId/items/:id"
    },
    "getCategories": {
      "method": "GET",
      "path": "/categories"
    },
    "getPersons": {
      "method": "GET",
      "path": "/persons"
    },
    "addItem": {
      "method": "POST",
      "path": "/lists/:deviceId/items"
    },
    "editItem": {
      "method": "POST",
      "path": "/lists/:deviceId/items/:id"
    },
    "checkItem": {
      "method": "POST",
      "path": "/lists/:deviceId/items/:id/checked"
    },
    "uncheckItem": {
      "method": "POST",
      "path": "/lists/:deviceId/items/:id/unchecked"
    },
    "changeQuantity": {
      "method": "POST",
      "path": "/lists/:deviceId/items/:id/quantity"
    },
    "removeItem": {
      "method": "DELETE",
      "path": "/lists/:deviceId/items/:id"
    },
    "removeChecked": {
      "method": "POST",
      "path": "/lists/:deviceId/remove-checked"
    },
    "clearList": {
      "method": "POST",
      "path": "/lists/:deviceId/clear"
    }
  }
}
